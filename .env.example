# Extension Monetization Kit storefront
# Safe to commit: names/placeholders only. Never commit real API keys or Blob tokens.

# Kit catalog IDs. These are the only new Paddle values normally required.
EXTENSION_KIT_PRODUCT_ID=
EXTENSION_KIT_PRICE_ID=

# Optional overrides. If omitted, the storefront reuses the already-working
# PADDLE_CLIENT_TOKEN and PADDLE_API_KEY from the existing Rainnight site.
EXTENSION_KIT_CLIENT_TOKEN=
EXTENSION_KIT_PADDLE_API_KEY=

# Private Vercel Blob store used to deliver the paid ZIP.
BLOB_READ_WRITE_TOKEN=
EXTENSION_KIT_BLOB_PATH=
